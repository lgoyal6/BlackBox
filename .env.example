# --- MongoDB (required) ---
# Copy this file to .env.local (gitignored). npm run check and npm run indexes need this.
# Cluster must be Flex or dedicated — M0 caps at 3 Atlas Search indexes; we need 4.
MONGODB_URI=
MONGODB_DB=blackbox

# --- Embeddings (required; Voyage preferred, it is MongoDB-owned) ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIM=1024                       # MUST match vector index numDimensions (npm run indexes)
# openai fallback: EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
# After changing model+dim, run: npx tsx scripts/create-indexes.ts --drop-vector

# --- LLM for graph nodes, postmortem + ePCR generation (required) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- ElevenLabs (required) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# --- App ---
PUBLIC_BASE_URL=
TOOL_SHARED_SECRET=
TRIGGER_MODE=changestream

# --- Port modes: set to `fake` to build a phase in isolation ---
EMBEDDINGS_MODE=real
RETRIEVAL_MODE=real
MEMORY_MODE=real
LLM_MODE=real
EVENTS_MODE=real
GRAPH_MODE=real
VOICE_MODE=real
NEXT_PUBLIC_EVENTS_MODE=real

# --- Optional ---
SOCRATA_APP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_MEDIC_PHONE=
